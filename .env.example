# Supabase Cloud Database Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side Supabase Service Role Key (Used exclusively by Vercel serverless /api endpoints)
# NEVER expose this key in frontend code or prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Device API Key for ESP32 authentication (if configured, ESP32 must provide x-api-key header)
DEVICE_API_KEY=
